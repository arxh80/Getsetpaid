# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
service-role*

# Supabase local dev
.branches/
supabase/.temp/
supabase/.branches/

# .claude/skills/<name> is a local junction into .agents/skills/<name>.
# The real skill content is committed under .agents/ — committing both makes
# git write duplicate real files on clone and breaks the junction.
.claude/skills/

# Agent worktrees: full working copies including node_modules. The branch is
# the durable record of the work; the checkout is disposable.
.claude/worktrees/

# Per-machine Claude Code settings (permissions differ per developer).
.claude/settings.local.json

# Agent planning/review scratch (briefs, reports, ledgers, review diffs). It
# was excluded only by an untracked, self-ignoring .superpowers/sdd/.gitignore
# that exists on one machine; listed here so it holds on every clone. The two
# DECISIONS-QUEUE files already tracked under it stay tracked.
.superpowers/

# graphify knowledge-graph output — regenerated from source, not source itself.
graphify-out/

# Test / E2E output
playwright-report/
test-results/
blob-report/

# Pentest skill artefacts (supabase-audit-rls) — findings and keys, never commit
.sb-pentest-context.json
.sb-pentest-audit.log
.sb-pentest-evidence/

# Python (tooling scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Word lock files (the PRD is committed; its lockfile is not)
~$*.docx

# Local scratch
*.local
tmp/
scratch/

# A peer session's hand-written demo fixture: hard-coded organisation and user
# uuids for one local database, useful on the machine that wrote it and wrong
# on every other one. It was committed by accident in 9f6fec4 and untracked
# again in Task 4 fix round 1 (review finding M3); the file stays on disk.
scripts/demo-seed.sql

# ---------------------------------------------------------------------------
# Node / JS toolchain (GitHub default template)
# ---------------------------------------------------------------------------

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Next.js auto-generated (regenerated on every dev/build run)
next-env.d.ts

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Turborepo / Vercel
.turbo/
.vercel/

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Kept locally, not published
SECURITY.md
FOLLOW-UPS.md
