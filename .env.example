# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way -- CLAUDE.md: "Never commit secrets, .env files, Supabase service-role
# keys, or the contents of private buckets."
#
# For local development every value below except the Google ones comes from
# `supabase status` with the local stack running.

# ---------------------------------------------------------------------------
# Supabase -- browser-visible
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle at build time. Both of these
# are safe there: the URL is not a secret, and the anon/publishable key carries
# no privilege of its own -- RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used to build auth redirect URLs. Must exactly match
# supabase/config.toml's `site_url` (or appear in additional_redirect_urls),
# or Supabase rejects the redirect.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Supabase -- SERVER ONLY. NEVER prefix this NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Bypasses Row Level Security completely. Read by lib/supabase/admin.ts, which
# is marked `server-only` so the build fails if a Client Component ever reaches
# it. Its single sanctioned use in this phase is the GoTrue Admin API for
# invites -- never a table read or write (service_role holds no table grants
# anyway; see the Task 4 migration, design note (e)).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google SSO -- read by the SUPABASE AUTH SERVER, not by this app
# ---------------------------------------------------------------------------
# supabase/config.toml resolves these via env() when the stack starts. No
# application code reads them, which is why neither is NEXT_PUBLIC_.
#
# PROVISIONED. The Google Cloud OAuth client exists and a real sign-in has
# completed end to end (2026-09-09) against the hosted project.
#
# TWO PLACES, NOT ONE. env() substitution in supabase/config.toml only reaches
# the LOCAL stack. The hosted project reads its provider credentials from the
# Supabase dashboard (Authentication -> Providers -> Google); filling these in
# does nothing for it.
#
# THE SUBSTITUTION HAPPENS AT `supabase start`, NOT PER REQUEST. A stack
# started before this file existed sends Google the literal string
# "env(GOOGLE_OAUTH_CLIENT_ID)" and every sign-in fails. After editing either
# value, restart the stack.
#
# Authorised redirect URIs to register with Google -- BOTH are needed:
#   http://127.0.0.1:54321/auth/v1/callback            (local stack)
#   https://<project-ref>.supabase.co/auth/v1/callback (hosted project)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Brevo -- transactional email. SERVER ONLY. Read by lib/email/send.ts.
# ---------------------------------------------------------------------------
# Free tier: 300 emails/day. EU-based (GDPR sub-processor -- sign the DPA and
# add Brevo to the sub-processor list before it touches real personal data).
# Generate the API key in Brevo -> SMTP & API -> API Keys. NEVER prefix with
# NEXT_PUBLIC_. Also configure Brevo's SMTP relay as Supabase's custom SMTP for
# AUTH emails -- that is a separate dashboard/config.toml step, see
# docs/email-setup.md. This key is only for app-sent mail (feedback, alerts).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GetSetPaid
