# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way -- CLAUDE.md: "Never commit secrets, .env files, Supabase service-role
# keys, or the contents of private buckets."
#
# For local development every value below except the Google ones comes from
# `supabase status` with the local stack running.

# ---------------------------------------------------------------------------
# Supabase -- browser-visible
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle at build time. Both of these
# are safe there: the URL is not a secret, and the anon/publishable key carries
# no privilege of its own -- RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used to build auth redirect URLs. Must exactly match
# supabase/config.toml's `site_url` (or appear in additional_redirect_urls),
# or Supabase rejects the redirect.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Supabase -- SERVER ONLY. NEVER prefix this NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Bypasses Row Level Security completely. Read by lib/supabase/admin.ts, which
# is marked `server-only` so the build fails if a Client Component ever reaches
# it. Its single sanctioned use in this phase is the GoTrue Admin API for
# invites -- never a table read or write (service_role holds no table grants
# anyway; see the Task 4 migration, design note (e)).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google SSO -- read by the SUPABASE AUTH SERVER, not by this app
# ---------------------------------------------------------------------------
# supabase/config.toml resolves these via env() when the stack starts. No
# application code reads them, which is why neither is NEXT_PUBLIC_.
#
# PROVISIONED. The Google Cloud OAuth client exists and a real sign-in has
# completed end to end (2026-09-09) against the hosted project.
#
# TWO PLACES, NOT ONE. env() substitution in supabase/config.toml only reaches
# the LOCAL stack. The hosted project reads its provider credentials from the
# Supabase dashboard (Authentication -> Providers -> Google); filling these in
# does nothing for it.
#
# THE SUBSTITUTION HAPPENS AT `supabase start`, NOT PER REQUEST. A stack
# started before this file existed sends Google the literal string
# "env(GOOGLE_OAUTH_CLIENT_ID)" and every sign-in fails. After editing either
# value, restart the stack.
#
# Authorised redirect URIs to register with Google -- BOTH are needed:
#   http://127.0.0.1:54321/auth/v1/callback            (local stack)
#   https://<project-ref>.supabase.co/auth/v1/callback (hosted project)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Brevo -- transactional email. SERVER ONLY. Read by lib/email/send.ts.
# ---------------------------------------------------------------------------
# Free tier: 300 emails/day. EU-based (GDPR sub-processor -- sign the DPA and
# add Brevo to the sub-processor list before it touches real personal data).
# Generate the API key in Brevo -> SMTP & API -> API Keys. NEVER prefix with
# NEXT_PUBLIC_. Separately, Brevo's SMTP relay can be set as Supabase's custom
# SMTP for AUTH emails -- a dashboard/config.toml step that is NOT done yet, see
# docs/email-setup.md § 3. This key is only for app-sent mail (feedback, alerts).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GetSetPaid

# ---------------------------------------------------------------------------
# Notification recipient + delivery -- SERVER ONLY (Phase 7 Task 6).
# ---------------------------------------------------------------------------
# The ONE support/security contact (SECURITY.md § 13; CLAUDE.md § In-app
# feedback -- no separate feedback address yet). Receives the feedback receipt
# and the incident-alert digest. Unset = feedback is stored and NOT emailed
# (logged, notified_at stays null), alerts are rows and not emails.
SUPPORT_CONTACT_EMAIL=
# Bearer secret the DATABASE's own clock presents to POST
# /api/incident-alerts/deliver (at least 32 characters; `openssl rand -hex 32`).
# Unset = that route answers 404 to everyone and nothing delivers alerts.
#
# The scheduler is pg_cron + pg_net in Postgres (founder ruling Q118,
# migration 20260916000000), NOT an external cron -- so this value must ALSO
# be put into Supabase Vault, by hand, once per environment, because a
# migration is committed source and cannot carry a secret:
#
#   select vault.create_secret('https://<host>/api/incident-alerts/deliver',
#                              'incident_alert_delivery_url',  '...');
#   select vault.create_secret('<the same value as below>',
#                              'incident_alert_delivery_secret', '...');
#
# With either Vault entry missing the job runs every 10 minutes and returns
# without building a request -- which is what local dev does, deliberately.
INCIDENT_ALERT_DELIVERY_SECRET=

# Bearer secret the DATABASE's own clock presents to POST /api/exports/run
# (at least 32 characters, and a DIFFERENT value from the one above).
#
# MISSING FROM THIS FILE UNTIL PHASE 8 TASK 5, which is a documentation gap
# Task 4 left rather than a new setting: SECURITY.md § 15 has carried it since
# that task shipped. Unset = the route answers 404 to everyone and the export
# runner has no retry -- exports still run, because the request that starts
# one nudges the runner in-process, but a job whose nudge died with its
# process waits for ever.
#
# Same Vault pair as the digest, by hand, once per environment:
#   select vault.create_secret('https://<host>/api/exports/run',
#                              'export_runner_url', '...');
#   select vault.create_secret('<the same value as below>',
#                              'export_runner_secret', '...');
EXPORT_RUNNER_SECRET=

# Bearer secret the DATABASE's own clock presents to POST /api/erasure/run
# (at least 32 characters, and a DIFFERENT value from both of the above --
# this is the one that makes queued DELETIONS happen sooner).
#
# It cannot CHOOSE a deletion: the route takes no argument, and every job it
# can reach is one somebody already asked for through a gate this endpoint
# does not control. Unset = 404 to everyone, and the erasure runner has no
# retry -- which matters more here than it does for exports, because a person
# whose account is "being deleted" and is not being deleted cannot even ask
# again (the one-live-job index refuses).
#
#   select vault.create_secret('https://<host>/api/erasure/run',
#                              'erasure_runner_url', '...');
#   select vault.create_secret('<the same value as below>',
#                              'erasure_runner_secret', '...');
ERASURE_RUNNER_SECRET=

# THE RETENTION RUNNER'S BEARER (Phase 8 Task 6). >= 32 characters, and a
# DIFFERENT value from all three above. It is the fourth and last of these,
# and the one whose blast radius includes the audit log: `pg_cron` ->
# `private.deliver_retention_sweep()` -> `pg_net` POST to
# /api/retention/run, throttled in the database to about hourly. It cannot
# choose what to delete -- every period is declared in
# private.retention_periods(), and the audit purge's hard floor, sanity
# ceiling and kill switch are all beyond this endpoint's reach. Unset = 404
# to everyone, and the consequence is quiet rather than loud: the job never
# runs, /super/health shows no runs at all (and says so in words), and data
# past its retention period is simply kept.
#
#   select vault.create_secret('https://<host>/api/retention/run',
#                              'retention_runner_url', '...');
#   select vault.create_secret('<the same value as below>',
#                              'retention_runner_secret', '...');
RETENTION_RUNNER_SECRET=
